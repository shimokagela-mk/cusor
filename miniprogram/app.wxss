page {
  --bg: #f4f1eb;
  --card: #fffcf8;
  --ink: #1f1a17;
  --muted: #7a716a;
  --line: #e6dfd6;
  --green: #1f7a4d;
  --green-soft: #e7f4ec;
  --amber: #9a6700;
  --amber-soft: #fff4d6;
  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.5;
}

view, text, input, button { box-sizing: border-box; }

.page { padding: 32rpx 32rpx 64rpx; }

.hero-title { font-size: 48rpx; font-weight: 600; line-height: 1.2; }
.kicker { color: var(--muted); font-size: 24rpx; margin-bottom: 8rpx; }
.muted { color: var(--muted); }
.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-top: 24rpx;
  border: 1rpx solid rgba(31, 26, 23, 0.05);
}
.card-title { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
.row { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.chips { display: flex; gap: 12rpx; margin-top: 24rpx; }
.chip {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #efeae3;
  color: var(--muted);
  font-size: 24rpx;
}
.chip.on { background: var(--green-soft); color: var(--green); }
.status {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #efeae3;
  font-size: 24rpx;
}
.status.done { background: var(--green-soft); color: var(--green); }
.status.missed { background: #fde8e4; color: #9c3b2e; }
.status.today { background: var(--amber-soft); color: var(--amber); }
.bar { height: 12rpx; background: #efeae3; border-radius: 999rpx; overflow: hidden; margin: 8rpx 0 16rpx; }
.bar-fill { height: 100%; background: var(--green); }
.bar-fill.over { background: var(--amber); }
.btn, button.btn {
  background: var(--green);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  line-height: 1.2;
  padding: 22rpx 28rpx;
  text-align: center;
}
button.btn::after, button.ghost::after, button.tiny::after { border: none; }
.ghost, button.ghost {
  background: transparent;
  color: var(--green);
  border: 1rpx solid var(--green);
  border-radius: 999rpx;
  font-size: 26rpx;
  padding: 16rpx 22rpx;
  line-height: 1.2;
}
.tiny, button.tiny {
  background: #efeae3;
  color: var(--ink);
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 12rpx 18rpx;
  line-height: 1.2;
  margin: 8rpx 8rpx 0 0;
}
.actions { display: flex; flex-wrap: wrap; margin-top: 8rpx; }
.field, input.field {
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
}
.options { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.option {
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid var(--line);
}
.option.on { border-color: var(--green); background: var(--green-soft); color: var(--green); }
.line { padding: 10rpx 0; border-bottom: 1rpx solid var(--line); }
.error { color: #9c3b2e; margin: 16rpx 0; }
.footer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 20rpx 32rpx calc(env(safe-area-inset-bottom) + 20rpx);
  background: rgba(244, 241, 235, 0.96);
}
.pad { height: 140rpx; }
.badge {
  display: inline-block;
  font-size: 22rpx;
  color: var(--green);
  background: var(--green-soft);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
  margin-left: 8rpx;
}
.food-line { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 0; }
.stepper { display: flex; align-items: center; gap: 12rpx; }
.empty { padding: 80rpx 12rpx; }
.week-day { padding: 22rpx 0; border-bottom: 1rpx solid var(--line); }
.chart { display: flex; align-items: flex-end; gap: 8rpx; height: 180rpx; margin-top: 16rpx; }
.chart-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
.chart-bar { width: 100%; background: var(--green); border-radius: 8rpx 8rpx 0 0; }
.chart-label { font-size: 18rpx; color: var(--muted); margin-top: 6rpx; }
.timer {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--green-soft);
  color: var(--green);
  text-align: center;
  font-size: 40rpx;
}
.set-row { display: flex; gap: 12rpx; align-items: center; margin-top: 12rpx; }
.set-row input { width: 140rpx; background: #fff; border: 1rpx solid var(--line); border-radius: 12rpx; padding: 10rpx; }
.photo { width: 100%; height: 360rpx; border-radius: 20rpx; background: #efeae3; margin-top: 16rpx; }
