  "sheet_3NoMc1wI": {
    "uid": "sheet_3NoMc1wI",
    "name": "纪要表",
    "sourceData": {
      "note": "轮次日志，每轮交互后必须立即插入一条新记录。\n- 列0: 时间跨度 - 本轮事件时间范围，格式 YYYY-MM-DD HH:MM 或 YYYY-MM-DD HH:MM ~ YYYY-MM-DD HH:MM。\n- 列1: 地点 - 本轮主要地点，从大到小。\n- 列2: 纪要 - 第三方视角客观记录本轮事实，不少于200字，不总结升华，不编造未出现情节。\n- 列3: 概览 - 30字以内一句话概括。\n- 列4: 编码索引 - 格式 AMXXXX，从 AM0001 递增，全表唯一。",
      "initNode": "故事初始化时插入 AM0001，记录开场。\nSQL示例: INSERT INTO chronicle (row_id, time_span, location, chronicle_text, summary, code_index) VALUES (1, '2026-03-10 10:00 ~ 2026-03-10 10:20', '澄禾科技-工程区', '工作日上午，玩家在工程区处理任务。公司前台、市场与后勤按日常运转。本轮尚未与核心同事展开深入互动，场景停留在到岗后的正常工作氛围。', '开场：工作日上午到岗。', 'AM0001');",
      "deleteNode": "禁止删除。",
      "updateNode": "禁止操作。",
      "insertNode": "每轮交互结束后插入一条新记录，编码索引递增。\nSQL示例: INSERT INTO chronicle (row_id, time_span, location, chronicle_text, summary, code_index) VALUES ((SELECT COALESCE(MAX(row_id),0)+1 FROM chronicle), '2026-03-10 12:05 ~ 2026-03-10 12:40', '公司附近-餐馆', '纪要正文……', '与同事午饭短聚。', 'AM0002');",
      "ddl": "CREATE TABLE chronicle ( -- 纪要表\n  row_id INTEGER PRIMARY KEY, -- 行号\n  time_span TEXT NOT NULL CHECK(time_span GLOB '????-??-?? ??:??' OR time_span GLOB '????-??-?? ??:?? ~ ????-??-?? ??:??'), -- 时间跨度\n  location TEXT NOT NULL, -- 地点\n  chronicle_text TEXT NOT NULL, -- 纪要\n  summary TEXT NOT NULL CHECK(LENGTH(summary) <= 60), -- 概览\n  code_index TEXT NOT NULL UNIQUE CHECK(code_index GLOB 'AM[0-9][0-9][0-9][0-9]') -- 编码索引\n);"
    },
    "content": [
      [
        "row_id",
        "时间跨度",
        "地点",
        "纪要",
        "概览",
        "编码索引"
      ]
    ],
    "updateConfig": {
      "uiSentinel": -1,
      "contextDepth": 6,
      "updateFrequency": 1,
